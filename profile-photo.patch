diff --git a/src/styles/components/contact.css b/src/styles/components/contact.css
new file mode 100644
index 0000000..37da902
--- /dev/null
+++ b/src/styles/components/contact.css
@@ -0,0 +1,39 @@
+/* ---- Contact: copy on the left, the Giza portrait on the right ---- */
+.contact-inner {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto;
+  align-items: center;
+  gap: clamp(var(--space-8), 6vw, var(--space-12));
+}
+
+.contact-photo {
+  width: clamp(220px, 24vw, 320px);
+  margin: 0;
+}
+
+.contact-photo img {
+  display: block;
+  width: 100%;
+  height: auto;
+  border: 1px solid var(--line);
+  border-radius: var(--radius-lg);
+  box-shadow: 0 24px 60px -28px color-mix(in srgb, var(--accent) 50%, transparent);
+}
+
+.contact-photo figcaption {
+  margin-top: var(--space-3);
+  color: var(--text-muted);
+  font-family: var(--font-mono);
+  font-size: 0.8rem;
+  text-align: center;
+}
+
+@media (max-width: 760px) {
+  .contact-inner {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .contact-photo {
+    width: min(100%, 280px);
+  }
+}
diff --git a/src/styles/components/hero.css b/src/styles/components/hero.css
index 7f43d56..684762d 100644
--- a/src/styles/components/hero.css
+++ b/src/styles/components/hero.css
@@ -80,3 +80,49 @@
     animation: none;
   }
 }
+
+/* ---- Profile photo: beside the copy on wide screens, above it on phones ---- */
+.hero-inner {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto;
+  align-items: center;
+  gap: clamp(var(--space-8), 5vw, var(--space-12));
+}
+
+.hero-photo {
+  position: relative;
+  width: clamp(240px, 26vw, 360px);
+  margin: 0;
+  aspect-ratio: 1;
+}
+
+/* A soft ring in the accent colors, so the photo belongs to the dark theme */
+.hero-photo::before {
+  content: '';
+  position: absolute;
+  inset: -6px;
+  z-index: -1;
+  border-radius: 50%;
+  background: conic-gradient(from 210deg, var(--accent), var(--accent-2), var(--accent));
+  opacity: 0.85;
+}
+
+.hero-photo img {
+  display: block;
+  width: 100%;
+  height: 100%;
+  border: 4px solid var(--bg);
+  border-radius: 50%;
+  object-fit: cover;
+}
+
+@media (max-width: 860px) {
+  .hero-inner {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .hero-photo {
+    order: -1; /* photo first, then name: the reader sees who before what */
+    width: clamp(120px, 34vw, 180px);
+  }
+}
